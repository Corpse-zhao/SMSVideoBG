#!/bin/bash
# ============================================================
# SMSVideoBG v1.3.0 postinst
#  1) 共享素材目录 (jbroot 主根 + Documents 辅根)
#  2) 信息App 数据容器内的素材目录  <- v1.3 插件在信息App 进程里必可达
#  3) 控制App 图标注册
#  4) 安装自检清单
# ============================================================

CTXS="all known unknown unread junk deleted chat"

# 1. 共享素材目录 (mobile 可读写, Filza 友好)
for MEDIA in "/var/jb/Library/SMSVideoBG" "/var/mobile/Documents/SMSVideoBG"; do
  for ctx in $CTXS; do
    mkdir -p "$MEDIA/$ctx" 2>/dev/null
    chmod 777 "$MEDIA" "$MEDIA/$ctx" 2>/dev/null
    chown -R mobile:mobile "$MEDIA" 2>/dev/null
  done
done

# 2. 信息App 数据容器内的素材目录
SMS_C=""
for base in /var/mobile/Containers/Data/Application \
            /private/var/mobile/Containers/Data/Application \
            /rootfs/var/mobile/Containers/Data/Application; do
  [ -d "$base" ] || continue
  for d in "$base"/*; do
    [ -f "$d/.com.apple.mobile_container_manager.metadata.plist" ] || continue
    if grep -qa "com.apple.MobileSMS" "$d/.com.apple.mobile_container_manager.metadata.plist" 2>/dev/null; then
      SMS_C="$d"; break
    fi
  done
  [ -n "$SMS_C" ] && break
done

if [ -n "$SMS_C" ]; then
  for ctx in $CTXS; do
    mkdir -p "$SMS_C/Library/SMSVideoBG/$ctx" 2>/dev/null
  done
  chmod -R 777 "$SMS_C/Library/SMSVideoBG" 2>/dev/null
  chown -R mobile:mobile "$SMS_C/Library/SMSVideoBG" 2>/dev/null
fi

# 3. 注册控制 App 图标 (尽力而为, 失败不影响安装)
for p in "/var/jb/Applications/SMSVideoBGApp.app" "/Applications/SMSVideoBGApp.app"; do
  if [ -d "$p" ]; then
    uicache -p "$p" >/dev/null 2>&1 || true
  fi
done

# 让信息App 下次启动时加载新插件
killall -9 MobileSMS >/dev/null 2>&1 || true

# 4. 安装自检清单 (root 执行, 必然可写)
LOG=/var/mobile/Documents/smsvideobg_install.log
{
  echo "=== postinst $(date) v1.3.0"
  echo "--- /var/jb -> $(readlink -f /var/jb 2>/dev/null)"
  for base in /var/jb /var/mobile/.jbroot* /var/containers/Bundle/Application/.jbroot*; do
    [ -d "$base" ] || continue
    D="$base/Library/MobileSubstrate/DynamicLibraries"
    if [ -f "$D/SMSVideoBG.dylib" ]; then
      echo "--- dylib: $D"
      ls -la "$D" | grep SMSVideoBG
      md5sum "$D/SMSVideoBG.dylib" 2>/dev/null
      echo "--- filter plist:"
      cat "$D/SMSVideoBG.plist" 2>/dev/null
    fi
    A="$base/Applications/SMSVideoBGApp.app"
    if [ -d "$A" ]; then
      echo "--- app: $A"
      ls -la "$A"
    fi
  done
  echo "--- hook 库:"
  ls -la /var/jb/usr/lib/libellekit* /var/jb/usr/lib/libsubstrate* /var/jb/Library/Frameworks/CydiaSubstrate.framework 2>/dev/null
  echo "--- 素材根目录:"
  ls -la /var/jb/Library/SMSVideoBG 2>/dev/null
  ls -la /var/mobile/Documents/SMSVideoBG 2>/dev/null
  echo "--- 信息App 数据容器素材目录: (SMS_C=$SMS_C)"
  ls -la "$SMS_C/Library/SMSVideoBG" 2>/dev/null
} >> "$LOG" 2>&1
chmod 644 "$LOG" 2>/dev/null
exit 0
