#!/bin/bash
# ============================================================
# SMSVideoBG postinst (v11.0.0)
#  1) 统一素材路径父目录 (软链在定位到容器后建)
#  2) 信息App / 备忘录App 数据容器内的素材根 (v11.0.0 双容器)
#  3) 控制App 图标注册
#  4) 精简自检 (日志带轮转)
#
#  v1.7.4 提速要点 (旧版装得慢的三个真凶):
#   a) 旧版对每个 App 容器逐个 fork 一次 grep 找信息App容器 —— 设备上几十上百个
#      容器 = 几十上百次进程创建+读盘。现改为「一次 grep 批量扫全部容器」。
#   b) 旧版对素材目录 chmod/chown -R 递归 —— 目录里存了视频时要遍历每个文件。
#      现只对目录层级本身设权限 (视频文件由 App 写入时属主本就是 mobile)。
#   c) 旧版自检日志无限追加 (>>) 越滚越大。现超过 64KB 自动轮转。
# ============================================================

LOG=/var/mobile/Documents/smsvideobg_install.log

# 0. 统一素材路径 (v10.3.0): /var/mobile/信息视频背景素材/板栗仁
#    用户只认这一条 —— 它是软链, 指向信息App 容器里的真实素材根(见第 2 段)。
#    这里只建父目录; 软链要等下面定位到容器之后再建。
FRIENDLY_PARENT="/var/mobile/信息视频背景素材"
FRIENDLY_LINK="$FRIENDLY_PARENT/板栗仁"
mkdir -p "$FRIENDLY_PARENT" 2>/dev/null
chmod 755 "$FRIENDLY_PARENT" 2>/dev/null
chown mobile:mobile "$FRIENDLY_PARENT" 2>/dev/null

# 1. (v10.4.0 取消) 旧版在这里给每个共享根建界面子目录 —— 现在所有界面共用
#    素材根一个文件夹, 子目录由 App/插件启动时摊平, 这里不再创建。

# 2. 信息App 数据容器内的素材目录
#    一次 grep 批量命中 (旧版是每容器一次 grep, 这是装得慢的主因)
SMS_C=""
for base in /var/mobile/Containers/Data/Application \
            /private/var/mobile/Containers/Data/Application \
            /rootfs/var/mobile/Containers/Data/Application; do
  [ -d "$base" ] || continue
  hit=$(grep -la -m1 -e "com.apple.MobileSMS" \
        "$base"/*/.com.apple.mobile_container_manager.metadata.plist 2>/dev/null \
        | head -n 1)
  if [ -n "$hit" ]; then
    SMS_C=$(dirname "$hit")
    break
  fi
done

if [ -n "$SMS_C" ]; then
  # v10.4.0: 只建素材根本身, 不再建 main/all/... 子目录
  mkdir -p "$SMS_C/Library/SMSVideoBG" 2>/dev/null
  chmod 777 "$SMS_C/Library/SMSVideoBG" 2>/dev/null
  chown mobile:mobile "$SMS_C/Library/SMSVideoBG" 2>/dev/null

  # 2.1 统一素材路径 -> 软链到信息App 容器里的真实素材根
  #     只处理「不存在 / 已是软链」; 若用户早已在那里建了真目录(里面可能有素材),
  #     留给控制 App 启动时搬运+改名备份, 这里绝不碰它的内容。
  TARGET="$SMS_C/Library/SMSVideoBG"
  if [ -L "$FRIENDLY_LINK" ]; then
    CUR=$(readlink "$FRIENDLY_LINK" 2>/dev/null)
    if [ "$CUR" != "$TARGET" ]; then
      rm -f "$FRIENDLY_LINK" 2>/dev/null
      ln -s "$TARGET" "$FRIENDLY_LINK" 2>/dev/null
    fi
  elif [ ! -e "$FRIENDLY_LINK" ]; then
    ln -s "$TARGET" "$FRIENDLY_LINK" 2>/dev/null
  fi
  chown -h mobile:mobile "$FRIENDLY_LINK" 2>/dev/null
fi

# 2.2 v11.0.0 双宿主: 备忘录App 容器素材根 + 「备忘录」软链
#     一次 grep 批量定位 com.apple.mobilenotes 容器 (与信息容器同法)
NOTES_C=""
for base in /var/mobile/Containers/Data/Application \
            /private/var/mobile/Containers/Data/Application \
            /rootfs/var/mobile/Containers/Data/Application; do
  [ -d "$base" ] || continue
  hit=$(grep -la -m1 -e "com.apple.mobilenotes" \
        "$base"/*/.com.apple.mobile_container_manager.metadata.plist 2>/dev/null \
        | head -n 1)
  if [ -n "$hit" ]; then
    NOTES_C=$(dirname "$hit")
    break
  fi
done

if [ -n "$NOTES_C" ]; then
  mkdir -p "$NOTES_C/Library/SMSVideoBG" 2>/dev/null
  chmod 777 "$NOTES_C/Library/SMSVideoBG" 2>/dev/null
  chown mobile:mobile "$NOTES_C/Library/SMSVideoBG" 2>/dev/null

  NOTES_LINK="$FRIENDLY_PARENT/备忘录"
  NOTES_TARGET="$NOTES_C/Library/SMSVideoBG"
  if [ -L "$NOTES_LINK" ]; then
    CUR=$(readlink "$NOTES_LINK" 2>/dev/null)
    if [ "$CUR" != "$NOTES_TARGET" ]; then
      rm -f "$NOTES_LINK" 2>/dev/null
      ln -s "$NOTES_TARGET" "$NOTES_LINK" 2>/dev/null
    fi
  elif [ ! -e "$NOTES_LINK" ]; then
    ln -s "$NOTES_TARGET" "$NOTES_LINK" 2>/dev/null
  fi
  chown -h mobile:mobile "$NOTES_LINK" 2>/dev/null
fi

# 3. 注册控制 App 图标 (尽力而为, 失败不影响安装)
# v1.8.4: 先把包目录授权给 mobile —— App 内「自定义名称/图标」要写 Info.plist
# 与 CustomIcon.png, deb 装出来的 .app 默认 root 属主, mobile 写不进去 (用户实测写入失败)
for p in "/var/jb/Applications/SMSVideoBGApp.app" "/Applications/SMSVideoBGApp.app"; do
  if [ -d "$p" ]; then
    chown -R mobile:mobile "$p" 2>/dev/null || true
    chmod -R u+rwX "$p" 2>/dev/null || true
    uicache -p "$p" >/dev/null 2>&1 || true
  fi
done

# 让信息App / 备忘录 下次启动时加载新插件
killall -9 MobileSMS >/dev/null 2>&1 || true
killall -9 MobileNotes >/dev/null 2>&1 || true

# 4. 精简自检 (root 执行, 必然可写; 日志超 64KB 自动轮转)
if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 65536 ]; then
  mv -f "$LOG" "$LOG.1" 2>/dev/null
fi
{
  echo "=== postinst $(date) v11.0.0"
  echo "jbroot: $(readlink -f /var/jb 2>/dev/null)"
  D=/var/jb/Library/MobileSubstrate/DynamicLibraries
  [ -f "$D/SMSVideoBG.dylib" ] && echo "dylib: OK $(stat -c%s "$D/SMSVideoBG.dylib" 2>/dev/null) bytes" || echo "dylib: MISSING"
  echo "SMS container: ${SMS_C:-NOT-FOUND}"
  echo "Notes container: ${NOTES_C:-NOT-FOUND}"
  echo "friendly path: $(readlink "$FRIENDLY_LINK" 2>/dev/null || echo '(未建/是真目录)')"
  echo "notes path: $(readlink "$FRIENDLY_PARENT/备忘录" 2>/dev/null || echo '(未建/是真目录)')"
} >> "$LOG" 2>&1
chmod 644 "$LOG" 2>/dev/null
exit 0
